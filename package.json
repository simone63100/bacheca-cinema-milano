{
  "name": "bijoux",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "scrape": "tsx --env-file-if-exists=.env.local scripts/scrape.ts",
    "eval:match": "tsx --env-file-if-exists=.env.local scripts/eval-match.ts",
    "e2e": "playwright test",
    "preview": "opennextjs-cloudflare build && node scripts/patch-opennext-win.mjs && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/patch-opennext-win.mjs && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.mts",
    "screens": "tsx scripts/screens.mts && python scripts/compose.py",
    "eval:holdout": "tsx --env-file-if-exists=.env.local scripts/eval-match.ts eval/holdout.json",
    "accents": "tsx --env-file=.env.local scripts/backfill-accents.mts"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "@neondatabase/serverless": "^1.2.1",
    "@opennextjs/cloudflare": "^1.20.17",
    "cheerio": "^1.2.0",
    "jpeg-js": "0.4.4",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.39.0",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
